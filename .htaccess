<IfModule mod_rewrite.c>
  RewriteEngine On

  # If requesting root, serve dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # If the file exists directly inside dist/, rewrite to dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # If not a physical file or directory, fallback to dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>
